<%
  var assets = { shell: 'public', scripts: ['/js/home.js'], bodyClass: 'home has-dock', progress: true };
  var steps = [
    { name: t('progress_reported'), you: t('how_s1_you'), cell: t('how_s1_cell') },
    { name: t('progress_review'), you: t('how_s2_you'), cell: t('how_s2_cell') },
    { name: t('progress_approved'), you: t('how_s3_you'), cell: t('how_s3_cell') },
    { name: t('progress_handed'), you: t('how_s4_you'), cell: t('how_s4_cell') }
  ];
  var feats = [
    { icon: 'search', title: t('feat_match_t'), body: t('feat_match_b') },
    { icon: 'qr', title: t('feat_qr_t'), body: t('feat_qr_b') },
    { icon: 'lock', title: t('feat_priv_t'), body: t('feat_priv_b') },
    { icon: 'chart', title: t('feat_stats_t'), body: t('feat_stats_b') }
  ];
  var compare = [
    { topic: t('why_r1_t'), before: t('why_r1_a'), after: t('why_r1_b') },
    { topic: t('why_r2_t'), before: t('why_r2_a'), after: t('why_r2_b') },
    { topic: t('why_r3_t'), before: t('why_r3_a'), after: t('why_r3_b') },
    { topic: t('why_r4_t'), before: t('why_r4_a'), after: t('why_r4_b') }
  ];
  var hasContact = contact.location || contact.phone || contact.email || contact.hours;
%><%- include('/partials/top', assets) %>
<section class="hp-hero" id="hero">
  <div class="container">
    <div class="hp-hero-grid">
      <div>
        <div class="hp-eyebrow"><%= t('home_uni') %></div>
        <h1><%= t('home_h1a') %><span class="hp-ul"><%= t('home_h1b') %><svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M1 6Q50 1 99 6" stroke="currentColor" stroke-width="3.5" fill="none" stroke-linecap="round"/></svg></span></h1>
        <p class="lead"><%= t('home_lead') %></p>
        <p class="hint"><%= user ? t('home_hint_in') : t('home_hint_out', { domains: allowedDomains.join(', ') }) %></p>
      </div>
      <figure class="hp-vis">
        <div class="hp-vis-art" role="img" aria-label="<%= t('home_art_alt') %>">
          <div class="hp-tks">
            <div class="hp-tk"><div class="hp-sd"><span><%= t('type_lost') %></span></div><div class="hp-bd"><small><%= t('home_case_code') %></small><code>SF-YYYY-NNNN</code><i class="hp-ln w88"></i><i class="hp-ln w60"></i></div></div>
            <div class="hp-tk is-found"><div class="hp-sd"><span><%= t('type_found') %></span></div><div class="hp-bd"><small><%= t('home_case_code') %></small><code>SF-YYYY-NNNN</code><i class="hp-ln w75"></i><i class="hp-ln w92"></i></div></div>
          </div>
          <div class="hp-fl"><i class="hp-br"></i><i class="hp-vl"></i><span class="hp-chip"><%= t('home_flow_review') %></span><i class="hp-vl"></i><span class="hp-chip is-ok"><%= t('home_flow_done') %></span></div>
        </div>
        <figcaption><%= t('home_art_caption') %></figcaption>
      </figure>
    </div>
    <div class="hp-tiles" role="group" aria-label="<%= t('home_actions') %>">
      <a class="hp-tile" href="/report?type=lost"><span class="hp-ti" aria-hidden="true"><%- icon('search') %></span><div><h3><%= t('home_cta_lost') %></h3><p><%= t('tile_lost_b') %></p></div><%- icon('arrow-right', 'hp-ar') %></a>
      <a class="hp-tile t2" href="/report?type=found"><span class="hp-ti" aria-hidden="true"><%- icon('box') %></span><div><h3><%= t('home_cta_found') %></h3><p><%= t('tile_found_b') %></p></div><%- icon('arrow-right', 'hp-ar') %></a>
      <a class="hp-tile t3" href="/track"><span class="hp-ti" aria-hidden="true"><%- icon('route') %></span><div><h3><%= t('tile_case_t') %></h3><p><%= t('tile_case_b') %></p></div><%- icon('arrow-right', 'hp-ar') %></a>
    </div>
  </div>
</section>

<section class="hp-sec hp-alt" id="board" aria-labelledby="board-h">
  <div class="container">
    <div class="hp-live" role="group" aria-label="<%= t('home_stats_label') %>">
      <div class="hp-stat"><span class="stat-num"><%= fmt.num(stats.openLost) %></span><span class="stat-label"><%= t('home_stat_lost') %></span></div>
      <div class="hp-stat"><span class="stat-num"><%= fmt.num(stats.openFound) %></span><span class="stat-label"><%= t('home_stat_found') %></span></div>
      <div class="hp-stat"><span class="stat-num"><%= fmt.num(stats.returned) %></span><span class="stat-label"><%= t('home_stat_returned') %></span></div>
    </div>
    <div class="hp-two">
      <div>
        <div class="hp-sr">
          <div><h2 id="board-h"><%= t('board_title') %></h2><p><%= t('board_sub') %></p></div>
          <a class="btn btn-secondary btn-sm" href="/browse"><%= t('board_all') %><%- icon('arrow-right') %></a>
        </div>
        <%- include('/partials/feed', { rows: list.rows }) %>
        <p class="hp-priv"><%- icon('lock') %><span><%= t('board_privacy') %></span></p>
      </div>
      <aside class="follow" aria-labelledby="follow-h">
        <h3 id="follow-h"><%= user ? t('follow_t_in') : t('follow_t') %></h3>
        <p><%= user ? t('follow_b_in') : t('follow_b') %></p>
        <% if (user) { %>
          <a class="btn btn-primary btn-block" href="/track"><%= t('nav_my_cases') %></a>
        <% } else { %>
          <a class="btn btn-primary btn-block" href="/auth/login"><%= t('nav_signin') %></a>
          <p class="follow-alt"><a href="/auth/register"><%= t('nav_register') %></a></p>
        <% } %>
      </aside>
    </div>
  </div>
</section>

<section class="container hp-band-wrap">
  <figure class="hp-band">
    <img src="/images/bup-campus.jpg" alt="<%= t('home_img_alt') %>" width="1350" height="658" loading="lazy">
    <figcaption><%= t('home_img_caption') %></figcaption>
  </figure>
</section>

<section class="hp-sec hp-alt" id="how" aria-labelledby="how-h2">
  <div class="container">
    <div class="hp-sh"><div class="hp-eyebrow"><%= t('nav_how') %></div><h2 id="how-h2"><%= t('how_h') %></h2><p><%= t('how_sub') %></p></div>
    <div data-steps>
      <div class="how-strip" role="tablist" aria-label="<%= t('progress_title') %>">
        <% steps.forEach(function (s, i) { %><button type="button" class="how-tab" role="tab" id="how-tab-<%= i + 1 %>" aria-controls="how-panel-<%= i + 1 %>" aria-selected="<%= i === 0 ? 'true' : 'false' %>"<%- i === 0 ? '' : ' tabindex="-1"' %>><span class="how-n"><%= i + 1 %></span><span class="how-name"><%= s.name %></span></button><% }) %>
      </div>
      <% steps.forEach(function (s, i) { %>
      <div class="how-panel<%= i === 0 ? ' is-active' : '' %>" role="tabpanel" id="how-panel-<%= i + 1 %>" aria-labelledby="how-tab-<%= i + 1 %>" tabindex="0">
        <h3 class="how-panel-h"><span class="how-n"><%= i + 1 %></span><%= s.name %></h3>
        <div class="how-cols">
          <div class="pn"><h3><%= t('how_you') %></h3><p><%= s.you %></p></div>
          <div class="pn"><h3><%= t('how_cell') %></h3><p><%= s.cell %></p></div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="hp-sec" id="features" aria-labelledby="feat-h">
  <div class="container">
    <div class="hp-sh"><div class="hp-eyebrow"><%= t('feat_tag') %></div><h2 id="feat-h"><%= t('feat_h') %></h2></div>
    <div class="hp-f4">
      <% feats.forEach(function (f) { %><div class="hp-feat"><%- icon(f.icon) %><h3><%= f.title %></h3><p><%= f.body %></p></div><% }) %>
    </div>
    <p class="hint hp-note"><%= t('feat_note') %></p>
  </div>
</section>

<section class="hp-sec hp-alt" id="why" aria-labelledby="why-h">
  <div class="container">
    <div class="hp-sh"><div class="hp-eyebrow"><%= t('why_tag') %></div><h2 id="why-h"><%= t('why_h') %></h2><p><%= t('why_sub') %></p></div>
    <div class="hp-cmp-wrap">
      <table class="hp-cmp">
        <thead><tr><td></td><th scope="col"><%= t('why_before') %></th><td aria-hidden="true"></td><th scope="col"><%= t('why_after') %></th></tr></thead>
        <tbody>
          <% compare.forEach(function (r) { %><tr><th scope="row"><%= r.topic %></th><td class="o"><%= r.before %></td><td class="ar" aria-hidden="true"><%- icon('arrow-right') %></td><td class="n"><%= r.after %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
    <p class="hint hp-note"><%= t('why_note') %></p>
  </div>
</section>

<section class="container hp-who-wrap" id="who">
  <div class="hp-who">
    <div><h2><%= t('who_h') %></h2><p><%= t('who_p') %></p></div>
    <% if (user) { %><a class="btn btn-primary" href="/report"><%= t('nav_report') %></a><% } else { %><a class="btn btn-primary" href="/auth/register"><%= t('nav_register') %></a><% } %>
  </div>
</section>

<section class="hp-sec hp-alt" id="contact" aria-labelledby="contact-h">
  <div class="container">
    <div class="hp-sh"><div class="hp-eyebrow"><%= t('nav_contact') %></div><h2 id="contact-h"><%= t('contact_h') %></h2><p><%= t('contact_sub') %></p></div>
    <div class="hp-team">
      <div class="tc">
        <h3><%= t('about_team_t') %></h3>
        <ul><% team.students.forEach(function (n) { %><li><%= n %></li><% }) %></ul>
        <p class="muted small"><%= team.cohort %></p>
        <h3 class="tc-next"><%= t('about_sup_t') %></h3>
        <ul><% team.supervisors.forEach(function (s) { %><li><strong><%= s.name %></strong><br><span class="muted small"><%= s.unit %></span></li><% }) %></ul>
      </div>
      <div class="tc">
        <h3><%= t('about_contact_t') %></h3>
        <% if (hasContact) { %>
        <dl class="kv">
          <% if (contact.location) { %><dt><%= t('contact_location') %></dt><dd><%= contact.location %></dd><% } %>
          <% if (contact.hours) { %><dt><%= t('contact_hours') %></dt><dd><%= contact.hours %></dd><% } %>
          <% if (contact.phone) { %><dt><%= t('contact_phone') %></dt><dd><a href="tel:<%= contact.phone.replace(/[^+0-9]/g, '') %>"><%= contact.phone %></a></dd><% } %>
          <% if (contact.email) { %><dt><%= t('contact_email') %></dt><dd><a href="mailto:<%= contact.email %>"><%= contact.email %></a></dd><% } %>
        </dl>
        <% } else { %>
        <p class="muted"><%= t('about_contact_none') %></p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<div class="dock" role="group" aria-label="<%= t('home_actions') %>">
  <a class="btn btn-primary" href="/report?type=lost"><%- icon('search') %><%= t('home_cta_lost') %></a>
  <a class="btn btn-secondary" href="/report?type=found"><%- icon('box') %><%= t('home_cta_found') %></a>
</div>
<%- include('/partials/bottom', assets) %>
