<%- include('/partials/top', { shell: 'auth' }) %>
<div class="auth-card">
  <% if (!invitee) { %>
    <h1><%= t('auth_link_bad_title') %></h1>
    <p><%= t('auth_invite_bad') %></p>
    <a class="btn btn-primary" href="/auth/login"><%= t('auth_back_login') %></a>
  <% } else { %>
    <h1><%= t('auth_invite_title') %></h1>
    <p class="sub"><%= t('auth_invite_sub', { name: invitee.name, role: t(roleKey[invitee.role]) }) %></p>
    <p class="muted small"><%= invitee.email %></p>
    <%- include('/partials/form-errors') %>
    <form method="post" action="/auth/invite/<%= token %>" novalidate>
      <%- csrfField() %>
      <%- include('/partials/field', { name: 'password', label: 'f_password_new', type: 'password', autocomplete: 'new-password', required: true, hint: 'f_password_hint', values: {} }) %>
      <%- include('/partials/field', { name: 'confirm', label: 'f_password_confirm', type: 'password', autocomplete: 'new-password', required: true, values: {} }) %>
      <button class="btn btn-primary btn-block" type="submit"><%= t('auth_invite_button') %></button>
    </form>
  <% } %>
</div>
<%- include('/partials/bottom', { shell: 'auth' }) %>
