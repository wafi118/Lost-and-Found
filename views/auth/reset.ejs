<%- include('/partials/top', { shell: 'auth' }) %>
<div class="auth-card">
  <% if (!valid) { %>
    <h1><%= t('auth_link_bad_title') %></h1>
    <p><%= t('auth_link_bad_body') %></p>
    <a class="btn btn-primary" href="/auth/forgot"><%= t('auth_forgot_title') %></a>
  <% } else { %>
    <h1><%= t('auth_reset_title') %></h1>
    <p class="sub"><%= t('auth_reset_sub') %></p>
    <%- include('/partials/form-errors') %>
    <form method="post" action="/auth/reset/<%= token %>" novalidate>
      <%- csrfField() %>
      <%- include('/partials/field', { name: 'password', label: 'f_password_new', type: 'password', autocomplete: 'new-password', required: true, hint: 'f_password_hint', values: {} }) %>
      <%- include('/partials/field', { name: 'confirm', label: 'f_password_confirm', type: 'password', autocomplete: 'new-password', required: true, values: {} }) %>
      <button class="btn btn-primary btn-block" type="submit"><%= t('auth_reset_button') %></button>
    </form>
  <% } %>
</div>
<%- include('/partials/bottom', { shell: 'auth' }) %>
