<%- include('/partials/top', { shell: 'auth' }) %>
<div class="auth-card">
  <% if (valid) { %>
    <h1><%= t('auth_verify_title') %></h1>
    <p><%= t('auth_verify_body') %></p>
    <form method="post" action="/auth/verify/<%= token %>">
      <%- csrfField() %>
      <button class="btn btn-primary btn-block" type="submit"><%= t('auth_verify_button') %></button>
    </form>
  <% } else { %>
    <h1><%= t('auth_link_bad_title') %></h1>
    <p><%= t('auth_link_bad_body') %></p>
    <a class="btn btn-primary" href="/auth/login"><%= t('auth_back_login') %></a>
  <% } %>
</div>
<%- include('/partials/bottom', { shell: 'auth' }) %>
