<%- include('/partials/top', { shell: 'auth' }) %>
<div class="auth-card">
  <h1><%= t('auth_forgot_title') %></h1>
  <% if (sent) { %>
    <p><%= t('auth_forgot_sent') %></p>
    <% if (devLink) { %><div class="dev-box"><strong><%= t('dev_link_title') %></strong><%= t('dev_link_body') %><br><a href="<%= devLink %>"><%= devLink %></a></div><% } %>
  <% } else { %>
    <p class="sub"><%= t('auth_forgot_sub') %></p>
    <%- include('/partials/form-errors', { formError: null }) %>
    <form method="post" action="/auth/forgot" novalidate>
      <%- csrfField() %>
      <%- include('/partials/field', { name: 'email', label: 'f_email', type: 'email', autocomplete: 'email', required: true, autofocus: true, inputmode: 'email' }) %>
      <button class="btn btn-primary btn-block" type="submit"><%= t('auth_forgot_button') %></button>
    </form>
  <% } %>
  <div class="auth-links"><a href="/auth/login"><%= t('auth_back_login') %></a></div>
</div>
<%- include('/partials/bottom', { shell: 'auth' }) %>
