<%- include('/partials/top') %>
<div class="page-head"><div><h1><%= t('nav_audit') %></h1><p><%= t('audit_sub') %></p></div></div>
<section class="panel">
  <form class="filters" method="get" action="/admin/audit" role="search">
    <div class="field field-grow">
      <label for="q"><%= t('browse_search') %></label>
      <input class="input" id="q" name="q" type="search" value="<%= filters.q %>" maxlength="60" placeholder="<%= t('audit_search_ph') %>">
    </div>
    <div class="field">
      <label for="action"><%= t('audit_action') %></label>
      <select class="select" id="action" name="action">
        <option value=""><%= t('audit_all_actions') %></option>
        <% actions.forEach(function (a) { %><option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a %></option><% }) %>
      </select>
    </div>
    <div class="field"><button class="btn btn-primary" type="submit"><%- icon('search') %><%= t('browse_apply') %></button></div>
  </form>
  <% if (!list.rows.length) { %>
    <%- include('/partials/empty', { art: 'clipboard', heading: t('list_empty_title'), message: t('audit_empty') }) %>
  <% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th><%= t('audit_time') %></th><th><%= t('audit_actor') %></th><th><%= t('audit_action') %></th><th><%= t('audit_entity') %></th><th><%= t('audit_detail') %></th></tr></thead>
      <tbody>
        <% list.rows.forEach(function (r) { %>
        <tr>
          <td class="nowrap"><%= fmt.dateTime(r.at) %></td>
          <td><%= r.actor %><% if (r.role) { %><span class="sub"><%= t(roleKey[r.role] || 'role_member') %></span><% } %></td>
          <td><code><%= r.action %></code></td>
          <td class="mono"><%= r.entity %></td>
          <td><%= r.detail %><% if (r.ip) { %><span class="sub"><%= r.ip %></span><% } %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
  <%- include('/partials/pager', { list: list, base: '/admin/audit', params: filters }) %>
</section>
<%- include('/partials/bottom') %>
