<%
  var fid = 'f-' + name;
  var err = locals.errors && errors[name];
  var cur = (locals.values && values[name] !== undefined && values[name] !== null) ? String(values[name]) : (locals.selected !== undefined ? String(selected) : '');
  var describedBy = [];
  if (locals.hint) describedBy.push('h-' + name);
  if (err) describedBy.push('e-' + name);
%>
<div class="field<%= err ? ' has-error' : '' %>">
  <label for="<%= fid %>"><%= t(label) %><% if (locals.required) { %><span class="req" aria-hidden="true">*</span><% } %></label>
  <select class="select" id="<%= fid %>" name="<%= name %>"
    <% if (locals.required) { %>required<% } %>
    <% if (err) { %>aria-invalid="true"<% } %>
    <% if (describedBy.length) { %>aria-describedby="<%= describedBy.join(' ') %>"<% } %>>
    <% if (locals.blank) { %><option value=""><%= t(blank) %></option><% } %>
    <% options.forEach(function (o) { %><option value="<%= o.value %>"<%- o.approval ? ' data-approval="1"' : '' %><%= String(o.value) === cur ? ' selected' : '' %>><%= o.label %></option>
    <% }) %>
  </select>
  <% if (locals.hint) { %><p class="hint" id="h-<%= name %>"><%= t(hint, locals.hintParams) %></p><% } %>
  <% if (err) { %><p class="error-text" id="e-<%= name %>"><%- icon('alert') %><span><%= t(err.key, err.params) %></span></p><% } %>
</div>
