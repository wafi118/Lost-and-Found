<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>" data-flash data-type="<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
    <%- icon(flash.type === 'success' ? 'check' : (flash.type === 'error' || flash.type === 'warn' ? 'alert' : 'info')) %>
    <p><%= t(flash.key, flash.params) %></p>
    <button type="button" data-dismiss aria-label="<%= t('close') %>">×</button>
  </div>
<% } %>
