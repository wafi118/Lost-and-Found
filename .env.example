# Copy this file to .env and edit the copy. .env is ignored by git and must never be committed.
# Every setting is optional in development; the values shown are the defaults.

# ---- Server ---------------------------------------------------------------------------------
# Use production only on the real server: it turns off demo data and the on-screen e-mail links.
NODE_ENV=development
PORT=3000
# The public address of the site. Used in e-mailed links and QR codes.
BASE_URL=http://localhost:3000
# Behind a reverse proxy (nginx, a hosting platform) set this to 1 so the real visitor address
# is used for rate limits. Leave empty when the app is reached directly.
TRUST_PROXY=
# Secure cookies need HTTPS. In production this defaults to true.
COOKIE_SECURE=

# ---- Secrets (required in production) -------------------------------------------------------
# At least 24 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty in development, a random value is used for each run (sessions reset on restart).
SESSION_SECRET=
# Signs the handover QR codes. Use a different value from SESSION_SECRET.
QR_SECRET=
# Password hashing cost. The default (12) is right for production; leave it unset so the tests can use a faster value.
# BCRYPT_ROUNDS=12

# ---- Database -------------------------------------------------------------------------------
# Required outside the test suite. Cases, accounts, claims and sessions all live here.
# Create an empty database, then start the app: it applies docs/schema.sql on first connect.
# To copy a ready database instead: psql "$DATABASE_URL" -f database/safefind.sql
DATABASE_URL=postgres://safefind:safefind@127.0.0.1:5432/safefind

# ---- Who may have an account ----------------------------------------------------------------
# Comma-separated e-mail domains. Confirm the exact student and staff domains with the university.
ALLOWED_EMAIL_DOMAINS=bup.edu.bd
# true: also accept subdomains such as student.bup.edu.bd
ALLOW_EMAIL_SUBDOMAINS=true
# true: a person who confirmed their e-mail still waits for an administrator to activate the account.
REQUIRE_ADMIN_APPROVAL=false
# Registration with an ID card photo, for people who have no university e-mail address (AUTH-8 to AUTH-12).
# false: the second registration form disappears.
ALLOW_ID_CARD_REGISTRATION=true
# How many photos one person may send in total. A rejection after the last one is final.
ID_CARD_MAX_ATTEMPTS=3
# The ID card photo is deleted this many days after the administrator decides. 0: at the next clean-up (every 6 hours).
ID_CARD_KEEP_DAYS=30
# Regular expressions for the ID typed at registration. Adjust to the real BUP formats.
STUDENT_ID_PATTERN=^\d{8,14}$
STAFF_ID_PATTERN=^[A-Za-z0-9][A-Za-z0-9\-/]{2,19}$

# ---- First administrator (production) ---------------------------------------------------------
# Used only when no administrator exists yet. Remove the password from .env after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# ---- E-mail -----------------------------------------------------------------------------------
# Without SMTP_HOST, e-mails are printed to the console and the "check your e-mail" page shows the
# link (development only). In production confirmation and reset e-mails need a working SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SafeFind BUP <no-reply@bup.edu.bd>

# ---- Uploads and limits -----------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=3
MAX_REPORTS_PER_DAY=10
MAX_CLAIMS_PER_DAY=5
# Requests per IP address per 15 minutes. If many students reach the server through one shared
# public address (campus NAT) they share this allowance, so raise it or pass real addresses via TRUST_PROXY.
RATE_LIMIT_GLOBAL=3000
RATE_LIMIT_LOGIN_FAILURES=20

# ---- Photo storage (optional) -----------------------------------------------------------------
# Photos go to Cloudinary when these are set, otherwise to the local UPLOAD_DIR folder. Use either the three
# variables or the single CLOUDINARY_URL from the Cloudinary dashboard (cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
# Photos are stored with private delivery and are only ever shown through this site, after the usual access check.
# On a host whose disk is wiped at every deploy, set Cloudinary: a local copy would be lost.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=
CLOUDINARY_FOLDER=safefind

# ---- Live alerts ------------------------------------------------------------------------------
# A new notification also appears as a message on the page the person has open (Socket.io over a WebSocket).
# Set to false if the server sits behind something that cannot pass WebSocket connections. Nothing is lost
# either way: notifications are stored, and the bell and the notifications page show them.
REALTIME=true

# ---- Demo data --------------------------------------------------------------------------------
# true loads sample cases and the demo accounts listed in README.md. Defaults to true outside production.
SEED_DEMO_DATA=

# ---- Contact details shown in the site footer (shown only when filled in) ---------------------
SECURITY_CELL_LOCATION=
SECURITY_CELL_PHONE=
SECURITY_CELL_EMAIL=
SECURITY_CELL_HOURS=

# ---- Map --------------------------------------------------------------------------------------
CAMPUS_LAT=23.8411
CAMPUS_LNG=90.3577
